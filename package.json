{
  "name": "soterra-app",
  "version": "1.0.0",
  "private": true,
  "description": "Casca Android e iPhone do SOTERRA (Capacitor). O jogo nao depende de Node: isto so empacota a pasta www/ que o tools/empacota_www.py monta.",
  "scripts": {
    "www": "python tools/empacota_www.py",
    "sync": "python tools/empacota_www.py && npx cap sync android",
    "abre": "npx cap open android",
    "sync:ios": "python tools/empacota_www.py && npx cap sync ios",
    "icones:ios": "python tools/icone_app.py --ios",
    "icones": "npx @capacitor/assets generate --android"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.2.0",
    "@capacitor-community/in-app-review": "^8.0.0",
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/local-notifications": "^8.0.0",
    "@capacitor/share": "^8.0.3",
    "@capgo/native-purchases": "^8.8.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2"
  }
}
