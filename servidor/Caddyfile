# SOTERRA — o Caddy na frente de tudo no VPS (HTTPS automático via Let's Encrypt).
# servidor/instala.sh troca jogo.exemplo.com.br pelo domínio que você passar.
# Troque jogo.exemplo.com.br pelo domínio real apontado para o VPS.
#
#   /                 → redireciona para /site/ (a landing pública)
#   /site/*           = as páginas públicas (site/ do repositório)
#   /index.html etc.  = o jogo (cliente estático, na raiz de /var/www/soterra)
#   /api/*            = a API de contas (servidor/api.py via systemd, porta 8300)
#   /ws               = o Relé (servidor/rele.py via systemd, porta 8791)

jogo.exemplo.com.br {
	root * /var/www/soterra
	encode zstd gzip

	# CACHE. O index.html (e o site) pede cada script e folha com o hash do
	# conteúdo dele (?v=, do js/versao.js que servidor/coolify/versao.py grava
	# ao instalar) e cada modelo com o hash do manifesto (?h=): se o conteúdo
	# muda, o endereço muda. Então endereço marcado fica um ano no navegador,
	# sem perguntar — MAS SÓ quando o hash é o do arquivo que ESTE servidor
	# tem: o versao.py grava, fora da pasta servida, uma marca vazia por
	# arquivo (/var/www/soterra-marcas/js/main.js.3fa2b1c9d0e1), e o matcher
	# file procura a marca do caminho pedido com o hash pedido. Sem a marca
	# (um hash que não é o daqui, ou o instala.sh no meio da troca — ele apaga
	# as marcas antes do rsync), responde no-cache: o navegador revalida em
	# vez de guardar por um ano o arquivo errado. O que não mudou mantém o
	# endereço (e o cache) de uma atualização para a outra.
	# O índice de tudo (as páginas, o js/versao.js e o manifesto) sempre
	# pergunta — no-cache é "revalide antes de usar" —, e o resto também.
	# Dentro do route a ordem é a escrita: vale o último header que casar.
	@marcado_v {
		query v=*
		file {
			root /var/www/soterra-marcas
			try_files {path}.{query.v}
		}
	}
	@marcado_h {
		query h=*
		file {
			root /var/www/soterra-marcas
			try_files {path}.{query.h}
		}
	}
	@indice path / *.html /js/versao.js /assets/models/bundle/manifest.json
	# A MÚSICA (assets/musica/, 06/10) não leva hash no endereço: o NOME do
	# arquivo é a faixa, e faixa trocada entra com nome novo. Fica 30 dias no
	# navegador — o <audio> pede por pedaços (Range), que o file_server atende.
	@musica path /assets/musica/*
	route {
		header Cache-Control "no-cache"
		header @marcado_v Cache-Control "public, max-age=31536000, immutable"
		header @marcado_h Cache-Control "public, max-age=31536000, immutable"
		header @musica Cache-Control "public, max-age=2592000"
		header @indice Cache-Control "no-cache"
	}

	# O tipo da música vai escrito: a imagem do Caddy (Alpine) não traz a tabela
	# de tipos do sistema, e sem ela .ogg e .mp3 sairiam sem Content-Type.
	@ogg path *.ogg
	header @ogg Content-Type audio/ogg
	@mp3 path *.mp3
	header @mp3 Content-Type audio/mpeg
	# o app-ads.txt da AdMob (na raiz, docs/GOOGLE_PLAY.md §10.5): texto puro — sem a tabela, sairia sem tipo
	@txt path *.txt
	header @txt Content-Type "text/plain; charset=utf-8"

	# O APLICATIVO DE ANDROID abre de https://localhost (os arquivos do pacote)
	# e baixa os modelos DAQUI, sob demanda, como a web. Buscar um .glb de outra
	# origem pede esta licença — dada SÓ à origem do aplicativo e SÓ na pasta
	# dos modelos, que já é pública. Para o navegador de quem joga na web (a
	# mesma origem) nenhum cabeçalho muda. A API responde por conta própria
	# (servidor/api.py) e o Relé é WebSocket, que não passa por isto.
	@do_aplicativo {
		path /assets/models/bundle/*
		header Origin https://localhost
	}
	header @do_aplicativo {
		Access-Control-Allow-Origin "https://localhost"
		+Vary Origin
	}

	# A raiz cai na landing. O jogo continua em /index.html — quem já tem o
	# link direto não sente nada. Só o caminho "/" exato é redirecionado.
	redir / /site/ 302

	# A API: o Caddy termina o HTTPS e repassa em claro para o localhost.
	handle /api/* {
		reverse_proxy 127.0.0.1:8300
	}

	# O Relé (WebSocket) — como já era.
	reverse_proxy /ws 127.0.0.1:8791

	file_server
}
