# systemd: o Relé sempre de pé, renascendo sozinho se cair.
#   sudo cp soterra-rele.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now soterra-rele
[Unit]
Description=SOTERRA - o Rele da Rede (WebSocket)
After=network.target

[Service]
ExecStart=/usr/bin/python3 /opt/soterra/rele.py --host 127.0.0.1 --porta 8791
Restart=always
RestartSec=3
User=www-data
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
