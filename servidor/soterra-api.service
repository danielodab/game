# systemd: a API sempre de pé, renascendo sozinha se cair.
#   sudo cp soterra-api.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now soterra-api
#
# Roda como o usuário `soterra` (crie antes: ver SUBIR.md) — o banco é a
# única coisa com estado no VPS e só esse usuário escreve nele.
# StateDirectory faz o systemd criar /var/lib/soterra com dono soterra na
# primeira subida, sem mkdir/chown à mão.
[Unit]
Description=SOTERRA - a API de contas (HTTP + SQLite)
After=network.target

[Service]
ExecStart=/usr/bin/python3 /opt/soterra/api.py --host 127.0.0.1 --porta 8300 --banco /var/lib/soterra/soterra.db
Restart=always
RestartSec=3
User=soterra
StateDirectory=soterra
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
