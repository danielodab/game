# O que roda no VPS (Linux) tem fim de linha LF sempre — mesmo com
# core.autocrlf=true no Windows. Sem isto o bash lê o instala.sh com \r no
# fim de cada linha ("$'\r': command not found") e para no primeiro comando.
*.sh        text eol=lf
*.service   text eol=lf
Caddyfile   text eol=lf
Dockerfile     text eol=lf
.dockerignore  text eol=lf
# As tabelas que tools/extrai_assets.py gera nascem em LF. O --conferir já as
# compara sem o fim de linha; isto as deixa iguais ao que o gerador escreve
# também num clone novo com core.autocrlf=true.
assets/models/bundle/tabelas/*.js  text eol=lf
# A música (assets/musica/) é binária: nunca troca fim de linha.
*.ogg  binary
*.mp3  binary
# O projeto do iPhone (ios/) é aberto e compilado num Mac ou na nuvem, nunca
# aqui: o que é texto vai sempre LF (o Xcode e o Capacitor escrevem assim), e o
# que é imagem o Git reconhece sozinho como binário.
ios/** text=auto eol=lf
